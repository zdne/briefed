DATABASE_URL=postgres://pnd:pnd@localhost:5432/pnd
PORT=3000
LOG_LEVEL=info

FEEDBIN_EMAIL=
FEEDBIN_PASSWORD=
FEEDBIN_BASE_URL=https://api.feedbin.com/v2

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4.1-mini

# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-latest

REDDIT_ENRICHMENT_MODE=embedded_only
QUERY_LIMIT=8
DIGEST_HOURS=24
DIGEST_MAX_ENTRIES=200
DIGEST_OUTPUT_DIR=output/digests
QUERY_OUTPUT_DIR=output/queries
