<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · Paid by Agent{% else %}Paid by Agent{% endif %}</title>
  {% set pageDescription = summary or "Daily briefing on how AI agents pay and get paid" %}
  <meta name="description" content="{{ pageDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://paidbyagent.com{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Paid by Agent{% endif %}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Paid by Agent{% endif %}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/favicon.png' | url }}" sizes="any">
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <div class="wrap">
    <header>
      <nav class="site-nav" aria-label="Primary navigation">
        <a class="site-name" href="{{ '/' | url }}">Paid by Agent</a>
        <a href="https://zdne.org/articles/agentic-payments/">Primer</a>
        <a href="{{ '/map/' | url }}">Map</a>
      </nav>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer>
      <p>Daily briefing archive &middot; a project by <a href="https://zdne.org">Z</a></p>
    </footer>
  </div>
</body>
</html>
