---
layout: base.njk
title: Briefings
permalink: /
eleventyExcludeFromCollections: true
---
<h1>Briefings</h1>
<ul class="post-list">
{% for post in collections.post | reverse %}
  <li>
    <span class="post-date">{{ post.data.date | readableDate }}</span>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </li>
{% endfor %}
</ul>
