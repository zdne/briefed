{
  "name": "brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "db:migrate": "tsx src/cli.ts migrate",
    "sync": "tsx src/cli.ts sync",
    "sync-feedbin": "tsx src/cli.ts sync-feedbin",
    "sync-rss": "tsx src/cli.ts sync-rss",
    "sync-gmail": "tsx src/cli.ts sync-gmail",
    "gmail-auth": "tsx src/cli.ts gmail-auth",
    "sync-twitter": "tsx src/cli.ts sync-twitter",
    "digest": "tsx src/cli.ts digest",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "site:dev": "eleventy --serve",
    "site:build": "eleventy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "dotenv": "^16.5.0",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.4.0",
    "html-to-text": "^9.0.5",
    "js-yaml": "^5.3.0",
    "openai": "^5.3.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
